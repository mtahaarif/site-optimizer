# Copy to .env.local and fill in what you use. Everything is optional — the tool
# degrades gracefully: no keys means alerts print to the console, rank tracking
# reports "no provider configured", and backlinks are seeded manually.
#
# Secrets live here, never in the database, so .data/sitechecker.db stays safe
# to commit or copy between machines.

# ---- Module 1: alerts ------------------------------------------------------
# SendGrid: 100 emails/day free forever. https://sendgrid.com
SENDGRID_API_KEY=
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=alerts@yourdomain.com

# Resend: 100/day, 3000/month free. Alternative to SendGrid.
RESEND_API_KEY=

# Slack or Discord incoming webhook. Works alongside email.
ALERT_WEBHOOK_URL=

MONITOR_TIMEOUT_MS=15000
SSL_WARN_DAYS=14

# ---- Module 2: SERP provider ----------------------------------------------
# Pick one. All have a free tier of roughly 100 searches/month.
# SerpApi is the only one of the three that supports Yandex.
SERPAPI_KEY= 
VALUESERP_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Force a specific provider when several are configured.
SERP_PROVIDER=
# Override the monthly budget guard (default 100 per provider).
SERP_MONTHLY_LIMIT=
SERP_LANGUAGE=en

# ---- Core Web Vitals: PageSpeed Insights -----------------------------------
# Free from the Google Cloud console (enable the PageSpeed Insights API).
# Without a key, requests use Google's shared anonymous quota, which is small
# and in practice frequently already exhausted — expect measurements to fail.
# With a key: 25,000 requests/day.
PAGESPEED_API_KEY=

# Set to 1 to bypass the 24-hour result cache. Use after deploying a fix, when
# yesterday's cached measurement would be exactly the wrong answer.
PAGESPEED_NO_CACHE=

# ---- Module 3: Google Search Console ---------------------------------------
# Service account JSON, either inline or as a file path.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
# Property URL exactly as Search Console shows it:
#   https://example.com/     (URL-prefix property)
#   sc-domain:example.com    (domain property)
GSC_SITE_URL=

# How many backlinks to verify per scheduled run.
BACKLINK_BATCH=50

# ---- Search Console traffic + GA4 -------------------------------------------
# Both reuse GOOGLE_SERVICE_ACCOUNT_JSON above; only the OAuth scope differs.
#
# Search Console: add the service account email as a user on the property.
# GA4: enable the Google Analytics Data API, add the service account as a Viewer
# on the property, and set the NUMERIC property id from
# Admin > Property Settings -- not the G-XXXXXXX measurement id.
GA4_PROPERTY_ID=

# ---- JavaScript rendering (Playwright) -------------------------------------
# Only needed if no Chromium is resolvable. The pool tries, in order:
# this variable, Playwright's own build (npx playwright install chromium),
# system Chrome, then system Edge.
PLAYWRIGHT_CHROMIUM_PATH=

# ---- Storage ---------------------------------------------------------------
# Defaults to .data/sitechecker.db
SITECHECKER_DB=
